generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_PAID
  OVERDUE
  PAID
  VOID
  SUPERSEDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  UPI
  PAYPAL
  STRIPE
  CHECK
  OTHER
}

enum PaymentRecordStatus {
  RECORDED
  VOIDED
}

enum InvoiceActivityType {
  CREATED
  UPDATED
  SENT
  VIEWED
  PAYMENT_RECEIVED
  PAYMENT_VOIDED
  MARKED_PAID
  MARKED_PARTIALLY_PAID
  MARKED_OVERDUE
  VOIDED
  SUPERSEDED
  CORRECTION_ISSUED
  REMINDER_SENT
  PAYMENT_LINK_UPDATED
}


model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business?
  clients  Client[]
  invoices Invoice[]

  @@map("users")
}


model Business {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  ownerName String?
  email     String?
  phone     String?
  website   String?
  logoUrl   String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  taxId    String?
  taxLabel String?

  currency          String @default("USD")
  invoicePrefix     String @default("INV")
  nextInvoiceNumber Int    @default(1)
  defaultNotes      String?
  defaultTerms      String?

  bankName      String?
  accountName   String?
  accountNumber String?
  bankCode      String? 
  swift         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@map("businesses")
}


model Client {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  company String?
  email String?
  phone String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  taxId String?
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@index([userId])
  @@map("clients")
}


model Invoice {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String?
  business   Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
  clientId   String
  client     Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)

  
  number String
  status InvoiceStatus @default(DRAFT)

  issueDate DateTime @db.Date
  dueDate   DateTime @db.Date
  currency  String   @default("USD") 

  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @default(0) @db.Decimal(12, 2)
  amountPaid     Decimal @default(0) @db.Decimal(12, 2)
  balanceDue     Decimal @default(0) @db.Decimal(12, 2)

  notes               String?
  terms               String?
  paymentInstructions String?
  paymentUrl          String?
  paymentLabel        String?
  pdfUrl              String?

  fromSnapshot Json?
  toSnapshot   Json?

  sentAt    DateTime?
  viewedAt  DateTime?
  paidAt    DateTime?
  lockedAt  DateTime?

  version               Int       @default(1)
  parentInvoiceId       String?
  parentInvoice         Invoice?  @relation("InvoiceCorrections", fields: [parentInvoiceId], references: [id], onDelete: SetNull)
  corrections           Invoice[] @relation("InvoiceCorrections")
  supersededByInvoiceId String?   @unique
  supersededByInvoice   Invoice?  @relation("InvoiceSupersession", fields: [supersededByInvoiceId], references: [id], onDelete: SetNull)
  supersededInvoice     Invoice?  @relation("InvoiceSupersession")
  supersededAt          DateTime?
  correctionReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      InvoiceItem[]
  payments   Payment[]
  activities InvoiceActivity[]
  revisions  InvoiceRevision[]

  @@unique([userId, number])
  @@index([userId, status])
  @@index([userId, issueDate])
  @@index([userId, dueDate])
  @@index([userId, createdAt])
  @@index([clientId])
  @@index([parentInvoiceId])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  unit        String? 
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)

  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxName        String? 
  taxRate        Decimal @default(0) @db.Decimal(5, 2) 
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)

  amount   Decimal @db.Decimal(12, 2)
  position Int     @default(0) 

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id        String              @id @default(cuid())
  invoiceId String
  invoice   Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount    Decimal             @db.Decimal(12, 2)
  method    PaymentMethod       @default(OTHER)
  status    PaymentRecordStatus @default(RECORDED)
  paidAt    DateTime            @default(now())
  reference String?
  note      String?

  recordedByUserId String?
  voidedAt         DateTime?
  voidReason       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([invoiceId, status])
  @@map("payments")
}

model InvoiceActivity {
  id        String             @id @default(cuid())
  invoiceId String
  invoice   Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  type      InvoiceActivityType
  message   String?
  metadata  Json?
  createdAt DateTime           @default(now())

  @@index([invoiceId, createdAt])
  @@map("invoice_activities")
}

model InvoiceRevision {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  version     Int
  action      String
  reason      String?
  snapshot    Json
  createdById String?
  createdAt   DateTime @default(now())

  @@index([invoiceId, createdAt])
  @@index([invoiceId, version])
  @@map("invoice_revisions")
}
